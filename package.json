{
  "name": "understand-bible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm services:up && pnpm dev:apps",
    "dev:apps": "turbo run dev",
    "services:prepare": "node infra/prepare-local.mjs",
    "services:up": "pnpm services:prepare && docker compose -f infra/docker-compose.yml up -d --wait --wait-timeout 120",
    "services:status": "docker compose -f infra/docker-compose.yml ps",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "node --test infra/prepare-local.test.mjs && turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.7.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
